{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "definitions": {
        "stringMap": {
            "type": "object",
            "additionalProperties": { "type": "string" }
        },
        "freeObject": { "type": "object" },
        "nullableInt": { "type": ["integer", "null"] },
        "intOrPercentOrNull": { "type": ["integer", "string", "null"] }
    },
    "properties": {
        "global": { "$ref": "#/definitions/freeObject" },
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "namespaceOverride": { "type": "string" },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "repository": { "type": "string" },
                "tag": { "type": "string" },
                "digest": { "type": "string" },
                "pullPolicy": { "type": "string", "enum": ["", "Always", "IfNotPresent", "Never"] }
            },
            "required": ["repository"]
        },
        "imagePullSecrets": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "create": { "type": "boolean" },
                "name": { "type": "string" },
                "labels": { "$ref": "#/definitions/stringMap" },
                "annotations": { "$ref": "#/definitions/stringMap" },
                "automountServiceAccountToken": { "type": "boolean" }
            }
        },
        "rbac": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "create": { "type": "boolean" },
                "rules": { "type": "array", "items": { "type": "object" } }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": { "type": "boolean" },
                "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
                "labels": { "$ref": "#/definitions/stringMap" },
                "annotations": { "$ref": "#/definitions/stringMap" },
                "ports": { "type": "array", "items": { "type": "object" } }
            }
        },
        "deployment": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "replicas": { "type": "integer", "minimum": 0 },
                "revisionHistoryLimit": { "$ref": "#/definitions/nullableInt" },
                "labels": { "$ref": "#/definitions/stringMap" },
                "annotations": { "$ref": "#/definitions/stringMap" },
                "podLabels": { "$ref": "#/definitions/stringMap" },
                "podAnnotations": { "$ref": "#/definitions/stringMap" },
                "strategy": { "$ref": "#/definitions/freeObject" },
                "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
                "priorityClassName": { "type": "string" },
                "nodeSelector": { "$ref": "#/definitions/stringMap" },
                "tolerations": { "type": "array", "items": { "type": "object" } },
                "affinity": { "$ref": "#/definitions/freeObject" },
                "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
                "hostAliases": { "type": "array", "items": { "type": "object" } },
                "dnsPolicy": { "type": "string" },
                "dnsConfig": { "$ref": "#/definitions/freeObject" },
                "podSecurityContext": { "$ref": "#/definitions/freeObject" },
                "securityContext": { "$ref": "#/definitions/freeObject" },
                "initContainers": { "type": "array", "items": { "type": "object" } },
                "additionalContainers": { "type": "array", "items": { "type": "object" } },
                "command": { "type": "array", "items": { "type": "string" } },
                "args": { "type": "array", "items": { "type": "string" } },
                "ports": { "type": "array", "items": { "type": "object" } },
                "envFrom": { "type": "array", "items": { "type": "object" } },
                "env": { "type": "array", "items": { "type": "object" } },
                "lifecycle": { "$ref": "#/definitions/freeObject" },
                "startupProbe": { "$ref": "#/definitions/freeObject" },
                "readinessProbe": { "$ref": "#/definitions/freeObject" },
                "livenessProbe": { "$ref": "#/definitions/freeObject" },
                "resources": { "$ref": "#/definitions/freeObject" },
                "volumeMounts": { "type": "array", "items": { "type": "object" } },
                "volumes": { "type": "array", "items": { "type": "object" } }
            }
        },
        "pdb": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": { "type": "boolean" },
                "minAvailable": { "$ref": "#/definitions/intOrPercentOrNull" },
                "maxUnavailable": { "$ref": "#/definitions/intOrPercentOrNull" },
                "labels": { "$ref": "#/definitions/stringMap" },
                "annotations": { "$ref": "#/definitions/stringMap" }
            }
        },
        "autoscaling": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": { "type": "boolean" },
                "minReplicas": { "type": "integer", "minimum": 1 },
                "maxReplicas": { "type": "integer", "minimum": 1 },
                "metrics": { "type": "array", "items": { "type": "object" } },
                "behavior": { "$ref": "#/definitions/freeObject" },
                "labels": { "$ref": "#/definitions/stringMap" },
                "annotations": { "$ref": "#/definitions/stringMap" }
            }
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": { "type": "boolean" },
                "ingress": { "type": "array", "items": { "type": "object" } },
                "egress": { "type": "array", "items": { "type": "object" } },
                "labels": { "$ref": "#/definitions/stringMap" },
                "annotations": { "$ref": "#/definitions/stringMap" }
            }
        },
        "config": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "integer", "boolean"] }
        },
        "ingress": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": { "type": "boolean" },
                "labels": { "$ref": "#/definitions/stringMap" },
                "annotations": { "$ref": "#/definitions/stringMap" },
                "ingressClassName": { "type": "string" },
                "tls": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "hosts": { "type": "array", "items": { "type": "string" } },
                            "secretName": { "type": "string" }
                        },
                        "required": ["hosts"]
                    }
                },
                "httpHosts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "host": { "type": "string" },
                            "paths": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "path": { "type": "string" },
                                        "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
                                        "servicePortNumber": { "type": "integer" }
                                    },
                                    "required": ["path", "servicePortNumber"]
                                }
                            }
                        },
                        "required": ["host", "paths"]
                    }
                }
            }
        }
    }
}
